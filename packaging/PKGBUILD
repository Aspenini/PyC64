# Maintainer: Aspenini
pkgname=pyc64
pkgver=0.1.0
pkgrel=1
pkgdesc='A Python subset and C64 libraries compiled to native 6502/6510 programs'
arch=('x86_64')
url='https://github.com/Aspenini/PyC64'
license=('MIT')
depends=('glibc' 'gcc-libs' 'sdl2')
makedepends=('git' 'xmake>=2.8.5')
checkdepends=('python>=3.11')
optdepends=('vice: cross-check generated programs, including REU targets')
# The existing v0.1.0 archive predates pyc64run and pyc64test. Use the development source until
# an archive containing these binaries is published, then pin that archive/hash.
# Upload this recipe only after the corresponding runner changes are pushed.
source=("$pkgname::git+$url.git#branch=master"
        'chips::git+https://github.com/floooh/chips.git'
        'chrono-c64::git+https://github.com/ChronoCoders/C64.git')
sha256sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "$srcdir/$pkgname"
  # Use makepkg's clones for the pinned emulator submodules.
  git submodule init
  git config submodule.third_party/chips.url "$srcdir/chips"
  git config submodule.third_party/chrono.url "$srcdir/chrono-c64"
  git -c protocol.file.allow=always submodule update
}

build() {
  cd "$srcdir/$pkgname"
  xmake f --yes --plat=linux --arch=x86_64 --mode=release --toolchain=gcc \
    --cflags="$CFLAGS $CPPFLAGS" --cxxflags="$CXXFLAGS $CPPFLAGS" \
    --ldflags="$LDFLAGS" --python=python3
  xmake
}

check() {
  cd "$srcdir/$pkgname"
  # ROM-dependent tests are skipped unless the user's C64 ROMs are configured.
  xmake test
}

package() {
  cd "$srcdir/$pkgname"
  # makepkg runs package() in fakeroot; install only into its staging directory.
  XMAKE_ROOT=y xmake install -o "$pkgdir/usr"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -d "$pkgdir/usr/share/licenses"
  mv "$pkgdir/usr/share/pyc64/licenses" "$pkgdir/usr/share/licenses/$pkgname"
  cp -a examples "$pkgdir/usr/share/pyc64/examples"
}
