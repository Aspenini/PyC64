from pyc64.types import u8, u16

def enable(slot: u8) -> None: ...
def disable(slot: u8) -> None: ...
def position(slot: u8, x: u16, y: u8) -> None: ...
def color(slot: u8, value: u8) -> None: ...
def data(slot: u8, address: u16) -> None: ...

def shared_colors(first: u8, second: u8) -> None: ...

class Sprite:
    def __init__(self, index: u8) -> None: ...
    @property
    def index(self) -> u8: ...
    @property
    def x(self) -> u16: ...
    @x.setter
    def x(self, value: u16) -> None: ...
    @property
    def y(self) -> u8: ...
    @y.setter
    def y(self, value: u8) -> None: ...
    @property
    def color(self) -> u8: ...
    @color.setter
    def color(self, value: u8) -> None: ...
    @property
    def enabled(self) -> bool: ...
    @enabled.setter
    def enabled(self, value: bool) -> None: ...
    @property
    def multicolor(self) -> bool: ...
    @multicolor.setter
    def multicolor(self, value: bool) -> None: ...
    @property
    def expand_x(self) -> bool: ...
    @expand_x.setter
    def expand_x(self, value: bool) -> None: ...
    @property
    def expand_y(self) -> bool: ...
    @expand_y.setter
    def expand_y(self, value: bool) -> None: ...
    def enable(self) -> None: ...
    def disable(self) -> None: ...
    def set_data(self, address: u16) -> None: ...
