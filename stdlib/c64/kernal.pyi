from pyc64.types import u8

def open(logical: u8, device: u8, secondary: u8, name: str) -> bool: ...
def close(logical: u8) -> None: ...
def read_byte(logical: u8) -> u8: ...
def write_byte(logical: u8, value: u8) -> bool: ...
def write_text(logical: u8, text: str) -> bool: ...
def status() -> u8: ...
def error() -> u8: ...
